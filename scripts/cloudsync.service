[Unit]
Description=CloudSync Personal Cloud Storage Server
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/cloudsync
ExecStart=/usr/bin/python3 /opt/cloudsync/run.py --host 0.0.0.0 --port 8765
Restart=always
RestartSec=5
Environment=PORT=8765
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
